# Your WordPress install's REST API root. Read-only from this app — no
# WordPress credentials are needed here anymore, since publishing now
# happens through the CitiPlug admin (see its own repo for that setup).
WP_API_URL=https://news.citiplug.com/wp-json

# The actual public domain this frontend is deployed to. Every canonical
# URL, sitemap entry, and Open Graph tag is built from this — get it wrong
# and search engines index the wrong URLs for everything.
NEXT_PUBLIC_SITE_URL=https://magazine.citiplug.com

# Supabase project this frontend reads homepage layout, nav menu, branding,
# and promo cards from (same project the CitiPlug admin writes to).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public (anon key) — used client-side for analytics tracking only.
# Safe to expose; protected by RLS (public insert, admin-only read).
NEXT_PUBLIC_SUPABASE_URL=https://uysipsegizbixwgvwdzl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Push notifications — generated once for this project, safe to reuse.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is exposed to the browser on purpose (that's
# how Web Push works). VAPID_PRIVATE_KEY and PUSH_WEBHOOK_SECRET must stay
# server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BLCrZCtmt1iOC2Tfbd0z5kGf_94HqhSiprb2ZR5TJJPLqn4Nv_FLHXWzTMa1r7G3tUvthX7lvqX6yK4sYOlPBX0
VAPID_PRIVATE_KEY=lsPZmRnqXo_LhDHFfH83y3tW5pldFsJfz-70umPJ5Gk
PUSH_WEBHOOK_SECRET=df41ab5bceaa254a11469c715720fc6540df1be597571148

# Google Analytics 4 — leave blank if you don't want it running alongside
# the custom analytics dashboard already built into the CitiPlug admin.
# Get this from analytics.google.com → Admin → Data Streams → your stream.
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google AdSense — leave blank until you have real AdSense approval.
# Ad slots fall back to an empty placeholder (or a sold manual campaign,
# if one's configured in the admin) when this isn't set — nothing breaks.
# Format: ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
